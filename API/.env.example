# ===== CLOUD SQL DATABASE (POSTGRESQL) =====
# LƯU Ý: Ký tự @ trong password phải encode thành %40
DATABASE_URL=postgresql://postgres:password@host:5432/database_name

# ===== SUPABASE CONFIGURATION =====
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_anon_key

# ===== JWT AUTHENTICATION =====
SECRET_KEY=your_secret_key_min_32_characters

# ===== GOOGLE GEMINI AI (VERTEX AI) =====
# Vertex AI Configuration - More stable and production-ready
# Requires: gcloud auth application-default login
# Get more quota and access to latest models (gemini-3-flash-preview)
USE_VERTEX_AI=true
GCP_PROJECT_ID=your_gcp_project_id
GCP_LOCATION=global
GEMINI_MODEL=gemini-3-flash-preview

# Legacy AI Studio API key (not used when USE_VERTEX_AI=true)
# Get API key from: https://makersuite.google.com/app/apikey
# api_key=YOUR_GEMINI_API_KEY_HERE

# ===== GOOGLE OAUTH (Optional) =====
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# ===== GOOGLE PLACES API (Optional) =====
GOOGLE_PLACES_API_KEY=your_google_places_api_key

# ===== OTHER SETTINGS =====
CACHE_EXPIRY_SECONDS=3600
